[Unit]
Description=SWARMFLOW full-field camera and timestamped YOLO worker
After=network.target
[Service]
WorkingDirectory=/home/arduino/swarm/shared/TASK-012
ExecStart=/home/arduino/yolo-env/bin/python -u vision_worker.py
Environment=LIBCAMERA_LOG_LEVELS=*:ERROR
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
